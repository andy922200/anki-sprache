# Copy to ~/deploy/app.env on the VM and fill in real values.
# Most values can be copied from the Zeabur server service's env vars.

LOG_LEVEL=info

CORS_ORIGIN=https://anki.smlpoints.com
COOKIE_DOMAIN=anki-api.smlpoints.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Reusing Zeabur's values keeps existing logins valid; new values force everyone to log in again.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# MUST be identical to Zeabur's MASTER_KEY: users' saved LLM API keys are
# encrypted with it, and a different key makes them undecryptable.
MASTER_KEY=

GOOGLE_CLIENT_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

GOOGLE_TTS_API_KEY=
